# Server-only secrets. Do not commit a real .env file.
ADMIN_API_TOKEN=replace-with-a-long-random-token
BLOCKCHAIN_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional custody/HD wallet provider. The API must return {"address": "..."}.
DEPOSIT_WALLET_PROVIDER_URL=
DEPOSIT_WALLET_PROVIDER_TOKEN=
# Explorer keys belong here or in your secret manager, never in HTML/JavaScript.
ETHERSCAN_API_KEY=
TRONSCAN_API_KEY=
DATABASE_PATH=trading_platform.db
CORS_ORIGINS=http://localhost:5000
PORT=5000
FLASK_DEBUG=0
